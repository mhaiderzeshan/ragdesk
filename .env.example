# ─── RAGDesk Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is already in .gitignore.

# ─── Database ─────────────────────────────────────────────────────
# Used when DATABASE_URL is not set. The app auto-assembles:
#   postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ragdesk_db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname   # optional override

# ─── Authentication ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Redis (Celery broker / result backend) ───────────────────────
REDIS_URL=redis://redis:6379/0

# ─── AI Keys ───────────────────────────────────────────────────────
# Google Generative AI — used for Gemini embeddings (gemini-embedding-001)
GOOGLE_API_KEY=your_google_api_key
# Groq — used for LLM chat completions (OpenAI-compatible API)
GROQ_API_KEY=your_groq_api_key

# ─── CORS ──────────────────────────────────────────────────────────
# JSON list of allowed origins (no trailing slashes)
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","https://your-production-domain"]

# ─── OpenTelemetry ─────────────────────────────────────────────────
# "none" | "console" | "otlp"
OTEL_EXPORTER=console
OTEL_ENDPOINT=

# ─── Cloudflare R2 (S3-compatible object storage) ─────────────────
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ragdesk-docs

# ─── File Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─── Debug ────────────────────────────────────────────────────────
# Set to true to echo every SQL statement (dev only). Keep false in prod.
DEBUG=false
